{
    email {$ACME_EMAIL}
    servers {
        protocols h1 h2 h3
    }
}

# Both public hostnames use the same SolarNet stack. The frontend sends API
# requests to its current host, so customer and staff authentication remain
# same-origin and do not share browser tokens or cookies.
(solarnet_application) {
    encode zstd gzip

    @api {
        path /api/*
        path /sanctum/*
        path /storage/*
        path /docs*
    }
    handle @api {
        reverse_proxy backend-nginx:80
    }

    handle {
        reverse_proxy frontend:80
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    log {
        output stdout
        format console
    }
}

# Customer portal: its root is a customer sign-in entry point.
{$CUSTOMER_DOMAIN} {
    @customer_landing path /
    redir @customer_landing /customer/login permanent
    import solarnet_application
}

# Staff/admin billing application.
{$ADMIN_DOMAIN} {
    import solarnet_application
}

# Preserve historical staff links while moving the former billing hostname to
# the new permanent billing address. Caddy issues its own certificate first.
{$LEGACY_ADMIN_DOMAIN} {
    redir https://{$ADMIN_DOMAIN}{uri} permanent
}
